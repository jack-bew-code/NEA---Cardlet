    def add_username(self):
        # Retrieves the current values of password and username
        username = self.username_sign_up_var.get()
        password = self.password_sign_up_var.get()
        conn = sqlite3.connect('flashcards.db', timeout=10)
        self.raw_salt = self.salt()
        hashed_password = self.custom_hash(password)
        cursor.execute("INSERT INTO logins VALUES (?, ?, ?)", (username, hashed_password, self.raw_salt,))
        conn.commit()

    def random_character(self):
        i = randint(36,126)
        character = chr(i)
        return character
    
    def salt(self):
        len_salt = randint(5,12)
        i = 0
        salt = ''
        for i in range (0, len_salt):
            a = self.random_character()
            salt = salt + a
        return salt


    def custom_hash(self, input_string):
        hash_value = 0  
        salt = self.raw_salt
        char = input_string + salt
        for char in input_string:
            hash_value = (hash_value * 31 + ord(char)) & 0xFFFFFFFF  # Limit hash to 32 bits by anding
    
        hash_value = (hash_value << 5) | (hash_value >> 27)  # Rotate bits (5 left ord with 27 right)
        hash_value ^= 0xabcdef  # XORs with a constant ([2:])
        return hex(hash_value)


    def login(self, controller):
        # Retrieves the entered username and password
        username = self.username_login_entry.get()
        password = self.password_login_entry.get()
        
        # Fetch stored hash for this user
        cursor.execute("SELECT password FROM logins WHERE username = ?", (username,))
        data = cursor.fetchone()
        conn.commit()
        
        if data:
            stored_hashed_password = data[0]
            # Hash the entered password
            hashed_password = self.custom_hash(password)
            
            if hashed_password == stored_hashed_password:

# This is the class for the whole flashcard app (it boots the main window)
class FlashcardPages(ThemedTk):
    def __init__(self, *args):
        # Initialize the GUI
        ThemedTk.__init__(self, *args,theme='superhero')
        self.title('Cardlet') 

        # Set up the app icon
        cardlet_logo = PhotoImage(file="C:/cardlet-logo.png")
        self.iconphoto(True, cardlet_logo)

        # Create a container frame to hold the different pages (Login and Flashcard pages)
        container = tk.Frame(self)
        container.pack(side='top', fill='both', expand=True)  # Make the frame fill the window
        container.grid_rowconfigure(0, weight=1)  # Configure row resizing
        container.grid_columnconfigure(0, weight=1)  # Configure column resizing

        # Dictionary to store references to each page (frame) thats created
        self.frames = {}

        # Loop through each page (LoginPage and FlashcardApp)
        for i in (LoginPage, FlashcardApp):
            frame = i(container, self)  # Initialize each page
            self.frames[i] = frame  # Store each page in the frames dictionary
            frame.grid(row=0, column=0, sticky='nsew')  # Position pages on top of each other

        # Shows the login page when the program starts up
        self.show_frame(LoginPage)

    def show_frame(self, chosen_frame):
        # Raises the chosen frame to the front
        frame = self.frames[chosen_frame]
        frame.tkraise()


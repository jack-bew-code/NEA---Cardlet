# Defines the main FlashcardApp page
class FlashcardApp(tk.Frame):
    def __init__(self, parent, controller):
        # Initializes the frame
        tk.Frame.__init__(self, parent)
        self.controller = controller

        # Create a tabbed notebook widget for switching between pages
        notebook = ttk.Notebook(self)
        notebook.pack(expand=True, fill="both")  # Make the notebook fill the space

        # Create each tab (Add, Review)
        add_flashcard_frame = ttk.Frame(notebook)
        notebook.add(add_flashcard_frame, text='Add Flashcards')

        review_flashcard_frame = ttk.Frame(notebook)
        notebook.add(review_flashcard_frame, text='Review Flashcards')

        account_frame = ttk.Frame(notebook)
        notebook.add(account_frame, text = 'Account')

        # Set up text variables for form fields
        self.set_name_var = tk.StringVar()
        self.term_var = tk.StringVar()
        self.definition_var = tk.StringVar()

        # Add Flashcard Tabs
        tk.Label(add_flashcard_frame, text="Enter Set Name:").pack()
        tk.Entry(add_flashcard_frame, textvariable=self.set_name_var).pack()
        tk.Label(add_flashcard_frame, text="Enter Term:").pack()
        tk.Entry(add_flashcard_frame, textvariable=self.term_var).pack()
        tk.Label(add_flashcard_frame, text="Enter Definition:").pack()
        tk.Entry(add_flashcard_frame, textvariable=self.definition_var).pack()
        
        # Add Flashcard Button
        self.add_flashcard_button = tk.Button(add_flashcard_frame, text="Add Flashcard", command=self.add_flashcard)
        self.add_flashcard_button.pack()

        #add logout button
        self.logout_button = tk.Button(account_frame, text = 'Log Out', command=self.logout)
        self.logout_button.pack()

        # Review Flashcards Tab - Dropdown for sets and flashcard navigation buttons
        self.available_sets = self.get_set_names()  # Get available set names
        try:
            self.available_sets = self.get_set_names()
            self.review_set_name_var = tk.StringVar(value="Select a Set")  # Dropdown text variable
            self.review_set_menu = tk.OptionMenu(review_flashcard_frame, self.review_set_name_var, *self.available_sets)
            self.review_set_menu.pack()
        except TypeError as e:
            self.available_sets = self.get_set_names()
            self.review_set_name_var = tk.StringVar(value="No sets to view")  # Dropdown text variable
            self.review_set_menu = tk.OptionMenu(review_flashcard_frame, self.review_set_name_var,'there are still no sets to view')
            self.review_set_menu.pack()

        self.select_set_button = tk.Button(review_flashcard_frame, text="Select Set", command=lambda: self.review_flashcards(self.review_set_name_var.get()))
        self.select_set_button.pack()

        self.delete_button = tk.Button(review_flashcard_frame, text="Delete Set", command=self.delete_set)
        self.delete_button.pack()

        # Flashcard display and navigation buttons
        self.flashcard_label = tk.Label(review_flashcard_frame, text="", font=("Helvetica", 16))
        self.flashcard_label.pack(pady=10)
        self.flip_button = tk.Button(review_flashcard_frame, text="Flip Flashcard", command=self.flip_flashcard, state=tk.DISABLED)
        self.flip_button.pack(side=tk.LEFT, padx=5)
        self.next_button = tk.Button(review_flashcard_frame, text="Next Card", command=self.next_card, state=tk.DISABLED)
        self.next_button.pack(side=tk.LEFT, padx=5)
        self.prev_button = tk.Button(review_flashcard_frame, text="Previous Card", command=self.prev_card, state=tk.DISABLED)
        self.prev_button.pack(side=tk.LEFT, padx=5)

        self.current_set = []  # List to hold flashcards in the current set
        self.current_index = 0  # Index of the current flashcard
        self.showing_term = True  # Whether to show term (True) or definition (False)

    def get_set_names(self):
        # Query the database for all unique set names
        cursor.execute("SELECT DISTINCT set_name FROM flashcards")
        sets = cursor.fetchall()
        conn.commit()
        return [set_name[0] for set_name in sets]  # Return a list of set names

    def refresh_dropdown(self):
        # Updates dropdown menu with current set names
        self.available_sets = self.get_set_names()
        menu = self.review_set_menu["menu"]
        menu.delete(0, "end")
        for set_name in self.available_sets:
            menu.add_command(label=set_name, command=lambda value=set_name: self.review_set_name_var.set(value))
        self.review_set_name_var.set("Select a Set")

    def add_flashcard(self):
        # Retrieves the current values of set name, term, and definition
        set_name = self.set_name_var.get()
        term = self.term_var.get()
        definition = self.definition_var.get()
        conn = sqlite3.connect('flashcards.db', timeout=10)

        # Check that all fields have been filled out
        if set_name and term and definition:
            cursor.execute("INSERT INTO flashcards (set_name, term, definition) VALUES (?, ?, ?)", (set_name, term, definition))
            conn.commit()
            self.term_var.set("")  # Clear the term field
            self.definition_var.set("")  # Clear the definition field
            self.refresh_dropdown()  # Refresh dropdown after adding a new flashcard
        else:
            messagebox.showwarning("Input Error", "Please fill in all fields.")

    def review_flashcards(self, set_name):
        # Retrieve all flashcards in the selected set
        cursor.execute("SELECT term, definition FROM flashcards WHERE set_name = ?", (set_name,))
        self.current_set = cursor.fetchall()
        conn.commit()
        #conn.close()
        if self.current_set:
            self.current_index = 0
            self.showing_term = True
            self.flip_button.config(state=tk.NORMAL)
            self.next_button.config(state=tk.NORMAL)
            self.prev_button.config(state=tk.NORMAL)
            self.show_flashcard()  # Show the first flashcard
        else:
            self.flashcard_label.config(text="No flashcards in this set.")
            self.flip_button.config(state=tk.DISABLED)
            self.next_button.config(state=tk.DISABLED)
            self.prev_button.config(state=tk.DISABLED)

    def delete_set(self):
        # Deletes the selected flashcard set
        set_name = self.review_set_name_var.get()
        if set_name and set_name != "Select a Set":
            confirm = messagebox.askyesno("Delete Set", f"Are you sure you want to delete the set '{set_name}'?")
            if confirm:
                cursor.execute("DELETE FROM flashcards WHERE set_name = ?", (set_name,))
                conn.commit()
                self.refresh_dropdown()
        else:
            messagebox.showerror("Error", "Please select a valid set to delete.")

    def show_flashcard(self):
        # Displays either term or definition of the current flashcard
        if self.showing_term:
            self.flashcard_label.config(text=self.current_set[self.current_index][0])
        else:
            self.flashcard_label.config(text=self.current_set[self.current_index][1])

    def flip_flashcard(self):
        # Flips between term and definition
        self.showing_term = not self.showing_term
        self.show_flashcard()

    def next_card(self):
        # Go to the next flashcard
        self.current_index = (self.current_index + 1) % len(self.current_set)
        self.showing_term = True
        self.show_flashcard()

    def prev_card(self):
        # Go to the previous flashcard
        self.current_index = (self.current_index - 1) % len(self.current_set)
        self.showing_term = True
        self.show_flashcard()
    
    def logout(self):
        self.controller.show_frame(LoginPage)# Start the application
